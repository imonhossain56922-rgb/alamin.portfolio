# GEMINI_API_KEY: Required if server-side Gemini AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The production URL where this application is hosted.
APP_URL="MY_APP_URL"

# Optional Firebase Web Config overrides for external Vercel deployments
# (If omitted, the application loads firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
